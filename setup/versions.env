# The pinned revisions of the environment and where it lands; sourced by bash, every location overridable.

BASE_IMAGE=ubuntu:22.04
IMAGE_REPO=ghcr.io/psal-postech/coprocessor

# gem5.opt and the RISC-V toolchain are downloaded, one build per host architecture (x86_64, aarch64).
HOST_ARCH=$(uname -m)

# gem5's release carries gem5-vcix-<uname -m>.tar.gz for each host.
GEM5_RELEASE=vcix-v0.3.6
GEM5_URL=https://github.com/PSAL-POSTECH/gem5/releases/download/$GEM5_RELEASE/gem5-vcix-$HOST_ARCH.tar.gz
GEM5_TARGET=build/RISCV/gem5.opt
PYTHON=python3.11
PYYAML_VERSION=6.0

# Branch vcix: custom-1 and custom-2 go to a loaded model, and riscv/coprocessor.h is a copy of include/coprocessor.h.
SPIKE_REPO=https://github.com/PSAL-POSTECH/riscv-isa-sim.git
SPIKE_SHA=657b1152ab42c777e2e0f650360ae21d6ed7aead

VERILATOR_REPO=https://github.com/verilator/verilator.git
VERILATOR_SHA=24b2ac24c721fdad89bba75a492e02c6aa63f32e

PK_REPO=https://github.com/PSAL-POSTECH/riscv-pk.git
PK_SHA=9435c61acf3538bb2cde8f6b8afb74411479988b

# riscv-collab publishes its toolchains for x86_64 hosts only; the aarch64 one is the same tag built the same way by
# .github/workflows/toolchain.yml and published here (release riscv-gnu-toolchain-<tag>). GCC 16.1.0, clang 22.
TOOLCHAIN_TAG=2026.08.27
case "$HOST_ARCH" in
  x86_64)
    GEM5_SHA256=075a8e37c3e522919dfdd935f58d2d421960f1c86d34acec96b3417fc4144fbd
    TOOLCHAIN_URL=https://github.com/riscv-collab/riscv-gnu-toolchain/releases/download/$TOOLCHAIN_TAG/riscv64-elf-ubuntu-22.04-llvm.tar.xz
    TOOLCHAIN_SHA256=0d50756abf5283309d1b6169fd4b0e37bcbdedd6f63bab2ead178c00fbc86eaa
    ;;
  aarch64)
    GEM5_SHA256=7ea97cd2302fd894a1068332e80ece4cfbbc7a004a2717e1156fd960305c595f
    TOOLCHAIN_URL=https://github.com/PSAL-POSTECH/coprocessor/releases/download/riscv-gnu-toolchain-$TOOLCHAIN_TAG/riscv64-elf-ubuntu-22.04-llvm-aarch64.tar.xz
    TOOLCHAIN_SHA256=f0e66e4a98167cd9316c2505457cfab423c0f4cb4d0da4198f755ad32d421c3d
    ;;
  *)
    echo "no gem5 or RISC-V toolchain is published for a $HOST_ARCH host" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

VCIX_ENV_ROOT=${VCIX_ENV_ROOT:-/opt/vcix-env}
TOOLCHAIN_ROOT=${TOOLCHAIN_ROOT:-$VCIX_ENV_ROOT/riscv}
PK_ROOT=${PK_ROOT:-$VCIX_ENV_ROOT/riscv-pk}
PK_PREFIX=${PK_PREFIX:-$VCIX_ENV_ROOT/pk}
SPIKE_ROOT=${SPIKE_ROOT:-$VCIX_ENV_ROOT/riscv-isa-sim}
SPIKE_PREFIX=${SPIKE_PREFIX:-$VCIX_ENV_ROOT/spike}
GEM5_ROOT=${GEM5_ROOT:-$VCIX_ENV_ROOT/gem5}
VERILATOR_SRC=${VERILATOR_SRC:-$VCIX_ENV_ROOT/verilator-src}
VERILATOR_PREFIX=${VERILATOR_PREFIX:-$VCIX_ENV_ROOT/verilator}

SPIKE_BIN=$SPIKE_PREFIX/bin/spike
SPIKE_BUILD=$SPIKE_ROOT/build
PK_BIN=$PK_PREFIX/riscv64-unknown-elf/bin/pk
GEM5_BIN=$GEM5_ROOT/$GEM5_TARGET
VERILATOR_BIN=$VERILATOR_PREFIX/bin/verilator
